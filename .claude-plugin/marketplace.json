  "plugins": [
    {
      "name": "metabolomics",
      "source": {
        "source": "git-subdir",
        "url": "https://github.com/HolobiomicsLab/asb-skills-metabolomics.git",
        "path": "collections/metabolomics/v3",
        "ref": "main",
        "sha": "0eb9942cad2ca1437ae7a89eb3e9775d2e130561"
      },
      "description": "ASB Metabolomics. Computational metabolomics (predominantly LC-MS/MS; also LC-MS, GC-MS, NMR, mass-spectrometry imaging, ion mobility, lipidomics, multi-omics): spectral library matching, molecular networking, formula/structure annotation (SIRIUS), preprocessing, normalization, and statistics: 11,830 evidence-grounded skills over 1,989 tools, each derived from a method paper (journal article or preprint) and its code. Router-shaped: one skill is advertised (the router); the corpus ships as data and is retrieved on demand, so installing costs negligible context. It carries the grounding map `kb_bundle.json`, but not the Perspicacité grounding binder.",
      "version": "3.1.1",
      "author": {
        "name": "Holobiomics Lab",
        "url": "https://github.com/HolobiomicsLab"
      },
      "homepage": "https://github.com/HolobiomicsLab/asb-skill-collections",
      "repository": "https://github.com/HolobiomicsLab/asb-skill-collections",
      "license": "CC-BY-4.0",
      "keywords": [
        "metabolomics",
        "mass-spectrometry",
        "LC-MS",
        "annotation",
        "GNPS",
        "SIRIUS",
        "molecular-networking"
      ]
    },
