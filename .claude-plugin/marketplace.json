  "plugins": [
    {
      "name": "metabolomics",
      "source": {
        "source": "git-subdir",
        "url": "HolobiomicsLab/asb-skills-metabolomics",
        "path": "collections/metabolomics/v3",
        "ref": "main",
        "sha": "2e18fc03570be2538c86ea953cc15522cf6c726f"
      },
      "description": "ASB Metabolomics. Computational metabolomics (predominantly LC-MS/MS; also LC-MS, GC-MS, NMR, mass-spectrometry imaging, ion mobility, lipidomics, multi-omics): spectral library matching, molecular networking, formula/structure annotation (SIRIUS), preprocessing, normalization, and statistics: 11,830 evidence-grounded skills over 1,989 tools, each derived from a method paper (journal article or preprint) and its code. Router-shaped: three skills are advertised (the router, the asb-metabolomics licence gate and the asb-contribute contribution route), the corpus ships as data and is retrieved on demand, so installing costs negligible context. Includes a Perspicacité KB auto-grounding binder.",
      "version": "3.0.2",
      "author": {
        "name": "Holobiomics Lab",
        "url": "https://github.com/HolobiomicsLab"
      },
      "homepage": "https://github.com/HolobiomicsLab/asb-skill-collections",
      "repository": "https://github.com/HolobiomicsLab/asb-skill-collections",
      "license": "CC-BY-4.0",
      "keywords": [
        "metabolomics",
        "mass-spectrometry",
        "LC-MS",
        "annotation",
        "GNPS",
        "SIRIUS",
        "molecular-networking"
      ]
    },
